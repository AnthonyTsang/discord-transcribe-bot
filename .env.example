# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here

# ── Transcription backend ─────────────────────────────────────────────────────
# Which backend to use: "assemblyai" (default), "gcp", or "whisper"
TRANSCRIBER=assemblyai

# AssemblyAI — required when TRANSCRIBER=assemblyai
ASSEMBLYAI_KEY=your_assemblyai_api_key_here

# GCP Speech-to-Text — required when TRANSCRIBER=gcp
# Provide credentials using ONE of the two options below:
#
# Option A: inline JSON string (paste the contents of your service account key file)
GCP_CREDENTIALS_JSON=
#
# Option B: path to a service account key JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Optional: GCP project ID (usually inferred from the credentials)
GCP_PROJECT_ID=

# ── Guild ID (recommended) ────────────────────────────────────────────────────
# Your Discord server ID — enables instant slash command registration.
# If omitted, commands are registered globally (up to 1 h to propagate).
# Voice and text channels are configured at runtime via /setchannel.
GUILD_ID=

# ── Chunk timing ──────────────────────────────────────────────────────────────
# Minimum buffered audio before a speaker-switch triggers a flush (ms)
MIN_CHUNK_MS=5000
# Hard maximum — flushes unconditionally to keep latency manageable (ms)
MAX_CHUNK_MS=60000

# ── Transcription language ────────────────────────────────────────────────────
# AssemblyAI: ISO 639-1 code. Leave blank for auto-detection.
# Examples: en, fr, de, es, ja
ASSEMBLYAI_LANGUAGE=

# GCP Speech-to-Text: BCP-47 code. Defaults to en-US if blank.
# Examples: en-US, en-GB, fr-FR, de-DE, ja-JP
GCP_LANGUAGE=

# Whisper (local faster-whisper-server) — used when TRANSCRIBER=whisper
# Prerequisite: nvidia-container-toolkit must be installed on the Docker host
# URL of the faster-whisper-server (default matches the docker-compose whisper service)
WHISPER_URL=http://whisper:8000
# Whisper language code. Leave blank for auto-detection.
# Examples: yue (Cantonese), zh (Mandarin), en (English), ja (Japanese)
WHISPER_LANGUAGE=
# Optional prompt to guide Whisper's transcription style.
# Whisper mimics the style of the prompt, so including punctuation encourages it.
# Example for Cantonese: 以下係廣東話對話。（，。？！）
WHISPER_PROMPT=

# ── Transcription quality ─────────────────────────────────────────────────────
# Words below this confidence score are dropped (0.0–1.0)
MIN_CONFIDENCE=0.4

# ── Silence detection ─────────────────────────────────────────────────────────
# Audio chunks with RMS below this value are discarded without being transcribed
# (saves API costs). Range: 0–32767. Set to 0 to disable.
SILENCE_THRESHOLD=200

# ── Health check ──────────────────────────────────────────────────────────────
# Port for the HTTP health check endpoint (GET / → 200 JSON)
HEALTH_PORT=3000
